<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- MAPA -->
    <com.topografia.app.MapView
        android:id="@+id/mapaTopografico"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. BARRA DE FERRAMENTAS SUPERIOR -->
    <LinearLayout
        android:id="@+id/panelTools"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:background="@drawable/bg_hud"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnCad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="CAD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />

        <Button
            android:id="@+id/btnLocacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="LOCAR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4D3319" />

        <Button
            android:id="@+id/btnCogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="COGO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RTK"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />
    </LinearLayout>

    <!-- 2. PAINEL DE TELEMETRIA (Esquerda) -->
    <LinearLayout
        android:id="@+id/panelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/panelTools"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStatusRTK"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconectado"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNorteUTM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="N: ---"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLesteUTM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E: ---"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLatitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lat: ---"
            android:textColor="#888888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvLongitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lon: ---"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- PAINEL DE ALVO (Para Locação) -->
    <TextView
        android:id="@+id/tvResultadoCorteAterro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/panelStatus"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud"
        android:padding="8dp"
        android:text="---"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <!-- 3. PAINEL DE GREIDE/BASTÃO (Direita, seguro e sem amassar nada) -->
    <LinearLayout
        android:id="@+id/panelGreide"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_above="@id/panelCameraBtns"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_hud"
        android:padding="10dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etAlturaBastao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bastão (m)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:inputType="numberDecimal"
            android:backgroundTint="#00BFFF" />

        <EditText
            android:id="@+id/etCotaProjeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Grade (m)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:inputType="numberDecimal"
            android:backgroundTint="#00BFFF" />
    </LinearLayout>

    <!-- 4. BOTÕES DE CÂMERA LATERAIS -->
    <LinearLayout
        android:id="@+id/panelCameraBtns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/panelBottomControls"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <!-- Botão Zoom no Projeto -->
        <ImageButton
            android:id="@+id/btnZoomProjeto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_botao_redondo"
            android:backgroundTint="#00BFFF"
            android:src="@android:drawable/ic_menu_mapmode"
            android:tint="#FFFFFF"
            android:elevation="6dp" />

        <!-- Botão Centralizar em Mim -->
        <ImageButton
            android:id="@+id/btnCentralizar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_botao_redondo"
            android:backgroundTint="#333333"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#FFFFFF"
            android:elevation="6dp" />
    </LinearLayout>

    <!-- 5. BOTOES DE IMPORTAR E EXPORTAR (Rodapé) -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnImportar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="IMPORTAR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExportarCsv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="EXPORTAR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#D84315"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 6. PAINEL INFERIOR (Cota e Nome do Ponto Espaçosos) -->
    <RelativeLayout
        android:id="@+id/panelBottomControls"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_above="@id/bottomButtons"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_hud"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/llCotaBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COTA ATUAL"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#00BFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNomePonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/llCotaBase"
            android:layout_toStartOf="@id/btnGravarPonto"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Nome / ID"
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:inputType="textCapCharacters"
            android:backgroundTint="#00E676"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnGravarPonto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_botao_redondo"
            android:backgroundTint="#00E676"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#FFFFFF"
            android:elevation="4dp" />
    </RelativeLayout>
</RelativeLayout>
