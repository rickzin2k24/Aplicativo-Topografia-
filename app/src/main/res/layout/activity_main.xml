<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- MAPA EM TELA CHEIA -->
    <com.topografia.app.MapView
        android:id="@+id/mapaTopografico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUD: BARRA DE FERRAMENTAS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTools"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC121212"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:id="@+id/llTools"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnCad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="CAD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_cad"
                android:drawablePadding="4dp"
                android:backgroundTint="#333333"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnLocacao"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="LOCAR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_locacao"
                android:drawablePadding="4dp"
                android:backgroundTint="#4D3319"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnCogo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="COGO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_cogo"
                android:drawablePadding="4dp"
                android:backgroundTint="#333333"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="RTK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_rtk"
                android:drawablePadding="4dp"
                android:backgroundTint="#333333"
                android:elevation="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HUD: STATUS / TELEMETRIA (ESQUERDA) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:cardBackgroundColor="#CC121212"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardTools"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardGreide"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvStatusRTK"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desconectado"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNorteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="N: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLesteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLatitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lat: ---"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLongitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lon: ---"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HUD: GREIDE / CORTE-ATERRO (DIREITA) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGreide"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC121212"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardTools"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <EditText
                android:id="@+id/etAlturaBastao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bastão (m)"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#00BFFF" />

            <EditText
                android:id="@+id/etCotaProjeto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Grade (m)"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#00BFFF" />

            <!-- Painel "gigante" — é o mais olhado na locação -->
            <TextView
                android:id="@+id/tvResultadoCorteAterro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="---"
                android:textColor="#AAAAAA"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HUD: CONTROLES DE CAMPO (INFERIOR) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC121212"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnExportarCsv"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp">

        <RelativeLayout
            android:id="@+id/rlBottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/llCotaBase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COTA ATUAL"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvCota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#00BFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNomePonto"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/llCotaBase"
                android:layout_toStartOf="@id/btnGravarPonto"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:hint="ID Ponto"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:inputType="textCapCharacters"
                android:backgroundTint="#00E676"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnGravarPonto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_botao_redondo"
                android:src="@android:drawable/ic_menu_mylocation"
                android:tint="#FFFFFF"
                android:contentDescription="Gravar ponto" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- EXPORTAR CSV -->
    <Button
        android:id="@+id/btnExportarCsv"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="EXPORTAR LEVANTAMENTO (.CSV)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#D84315"
        android:textColor="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
