<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvStatusRTK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS: Desconectado"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvLatitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lat: ---"
        android:textSize="20sp"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/tvLongitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lon: ---"
        android:textSize="20sp"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cota NMEA: ---"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="16dp"/>

    <!-- Novos campos para digitar os dados -->
    <EditText
        android:id="@+id/etAlturaBastao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Altura do Bastão (m)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCotaProjeto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cota do Grade / Projeto (m)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <!-- Painel de resultado do Corte/Aterro -->
    <TextView
        android:id="@+id/tvResultadoCorteAterro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="---"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SIMULAR LEITURA RTK"
        android:textSize="16sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>
