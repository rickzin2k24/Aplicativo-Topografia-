<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- BARRA DE FERRAMENTAS -->
    <LinearLayout
        android:id="@+id/llTools"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnCad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🗺️ CAD"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>
        
        <Button
            android:id="@+id/btnLocacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🚩 LOCAR"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📐 COGO"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📡 RTK"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <!-- BOTÃO DE EXPORTAR -->
    <Button
        android:id="@+id/btnExportarCsv"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:text="EXPORTAR LEVANTAMENTO (.CSV)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#D84315"
        android:textColor="#FFFFFF"
        android:layout_margin="8dp"/>

    <!-- CONTROLES DE CAMPO -->
    <RelativeLayout
        android:id="@+id/rlBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnExportarCsv"
        android:background="#1E1E1E"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/llCotaBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COTA ATUAL"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvCota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#00BFFF"
                android:textSize="32sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etNomePonto"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/llCotaBase"
            android:layout_toStartOf="@id/btnGravarPonto"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="ID Ponto"
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:inputType="textCapCharacters"
            android:backgroundTint="#4CAF50"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btnGravarPonto"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_botao_redondo"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#FFFFFF"/>
    </RelativeLayout>

    <!-- TELA DO MAPA (MOTOR GRÁFICO CAD) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llTools"
        android:layout_above="@id/rlBottomControls"
        android:background="#191919">

        <com.topografia.app.MapView
            android:id="@+id/mapaTopografico"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvStatusRTK"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: Desconectado"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvNorteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvLesteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvLatitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat: ---"
                android:textColor="#888888"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvLongitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lon: ---"
                android:textColor="#888888"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="8dp">

            <EditText
                android:id="@+id/etAlturaBastao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bastão (m)"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#FFFFFF"/>

            <EditText
                android:id="@+id/etCotaProjeto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Grade (m)"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#FFFFFF"/>

            <TextView
                android:id="@+id/tvResultadoCorteAterro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
