<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- MAPA EM TELA CHEIA -->
    <com.topografia.app.MapView
        android:id="@+id/mapaTopografico"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD: BARRA DE FERRAMENTAS (TOPO) -->
    <LinearLayout
        android:id="@+id/panelTools"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hud"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">

        <Button
            android:id="@+id/btnCad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="CAD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_cad"
            android:drawablePadding="4dp"
            android:backgroundTint="#333333"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnLocacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="LOCAR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_locacao"
            android:drawablePadding="4dp"
            android:backgroundTint="#4D3319"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnCogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="COGO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_cogo"
            android:drawablePadding="4dp"
            android:backgroundTint="#333333"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RTK"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_rtk"
            android:drawablePadding="4dp"
            android:backgroundTint="#333333"
            android:elevation="0dp" />
    </LinearLayout>

    <!-- HUD: STATUS / TELEMETRIA (ESQUERDA) -->
    <LinearLayout
        android:id="@+id/panelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/panelTools"
        android:layout_alignParentStart="true"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStatusRTK"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconectado"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNorteUTM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="N: ---"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLesteUTM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E: ---"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLatitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lat: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLongitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lon: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- HUD: GREIDE / CORTE-ATERRO (DIREITA) -->
    <LinearLayout
        android:id="@+id/panelGreide"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/panelTools"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/etAlturaBastao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bastão (m)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:backgroundTint="#00BFFF" />

        <EditText
            android:id="@+id/etCotaProjeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Grade (m)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:backgroundTint="#00BFFF" />

        <!-- Painel "gigante" -->
        <TextView
            android:id="@+id/tvResultadoCorteAterro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="---"
            android:textColor="#AAAAAA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- EXPORTAR CSV (FUNDO DA TELA) -->
    <Button
        android:id="@+id/btnExportarCsv"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="EXPORTAR LEVANTAMENTO (.CSV)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#D84315"
        android:textColor="#FFFFFF" />

    <!-- HUD: CONTROLES DE CAMPO (ACIMA DO BOTAO EXPORTAR) -->
    <RelativeLayout
        android:id="@+id/panelBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnExportarCsv"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_hud"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/llCotaBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COTA ATUAL"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#00BFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNomePonto"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/llCotaBase"
            android:layout_toStartOf="@id/btnGravarPonto"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:hint="ID Ponto"
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:inputType="textCapCharacters"
            android:backgroundTint="#00E676"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnGravarPonto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_botao_redondo"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#FFFFFF"
            android:contentDescription="Gravar ponto" />
    </RelativeLayout>

</RelativeLayout>
