<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"> <!-- Fundo Escuro Moderno -->

    <!-- 1. BARRA DE FERRAMENTAS (TOPO) -->
    <LinearLayout
        android:id="@+id/llTools"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️"
            android:textSize="20sp"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>
        
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📚"
            android:textSize="20sp"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📏"
            android:textSize="20sp"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"/>

        <!-- O seu botão de conectar/simular agora é uma ferramenta no topo! -->
        <Button
            android:id="@+id/btnConectar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡"
            android:textSize="20sp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <!-- 4. BOTÃO DE EXPORTAR (BASE) -->
    <Button
        android:id="@+id/btnExportarCsv"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:text="EXPORTAR LEVANTAMENTO (.CSV)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#D84315"
        android:textColor="#FFFFFF"
        android:layout_margin="8dp"/>

    <!-- 3. CONTROLES DE CAMPO (ACIMA DO BOTÃO EXPORTAR) -->
    <RelativeLayout
        android:id="@+id/rlBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnExportarCsv"
        android:background="#1E1E1E"
        android:padding="16dp">

        <!-- Cota Atual (Esquerda) -->
        <LinearLayout
            android:id="@+id/llCotaBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COTA ATUAL"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvCota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#00BFFF"
                android:textSize="32sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Nome do Ponto (Centro) -->
        <EditText
            android:id="@+id/etNomePonto"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/llCotaBase"
            android:layout_toStartOf="@id/btnGravarPonto"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="ID Ponto"
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:inputType="textCapCharacters"
            android:backgroundTint="#4CAF50"
            android:gravity="center"/>

        <!-- Botão Redondo (Direita) -->
        <ImageButton
            android:id="@+id/btnGravarPonto"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_botao_redondo"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#FFFFFF"/>
    </RelativeLayout>

    <!-- 2. TELA DO MAPA (MEIO - OCUPA TODO O ESPAÇO RESTANTE) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llTools"
        android:layout_above="@id/rlBottomControls"
        android:background="#191919"> <!-- Cor do terreno -->

        <!-- Ícone do Rover (Você) no centro da tela -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:src="@android:drawable/ic_media_play"
            android:rotation="-90"
            android:tint="#00FF00"/>

        <!-- PAINEL FLUTUANTE HUD (Esquerda) - Posição -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvStatusRTK"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: Desconectado"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvNorteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvLesteUTM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E: ---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvLatitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat: ---"
                android:textColor="#888888"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvLongitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lon: ---"
                android:textColor="#888888"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- PAINEL FLUTUANTE HUD (Direita) - Projeto -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="8dp">

            <EditText
                android:id="@+id/etAlturaBastao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bastão (m)"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#FFFFFF"/>

            <EditText
                android:id="@+id/etCotaProjeto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Grade (m)"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:backgroundTint="#FFFFFF"/>

            <TextView
                android:id="@+id/tvResultadoCorteAterro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
